# 云寻智慧农业AI工作台软件 V1.0.0 配置示例
# 复制为 .env 后按需修改；不要提交真实 Secret、API Key 或本地路径。

# 基础必需
YUNXUN_APP_NAME=云寻智慧农业AI工作台软件
YUNXUN_APP_VERSION=1.0.0
YUNXUN_ENV=development
YUNXUN_HOST=0.0.0.0
YUNXUN_PORT=8001
YUNXUN_BACKEND_URL=http://127.0.0.1:8001
YUNXUN_DATABASE_URL=sqlite:///./backend/yunxun.db

# 生产安全
YUNXUN_JWT_SECRET=change-me-in-production
YUNXUN_TOKEN_EXPIRE_HOURS=168
YUNXUN_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
YUNXUN_CORS_METHODS=GET,POST,PATCH,DELETE,OPTIONS
YUNXUN_CORS_HEADERS=Authorization,Content-Type,X-Idempotency-Key,X-CSRF-Token
YUNXUN_COOKIE_SECURE=false
YUNXUN_COOKIE_SAME_SITE=lax

# 开发可选
YUNXUN_DEBUG=false
YUNXUN_MAX_MESSAGE_LENGTH=3000
YUNXUN_REQUESTS_PER_MINUTE=20
YUNXUN_UPLOAD_MAX_BYTES=5242880
YUNXUN_REQUEST_TIMEOUT_SECONDS=45
YUNXUN_AI_TIMEOUT_SECONDS=45
YUNXUN_AI_MAX_RETRIES=1
YUNXUN_LOG_LEVEL=INFO
YUNXUN_DEFAULT_PAGE_SIZE=20
YUNXUN_MAX_PAGE_SIZE=100
YUNXUN_IDEMPOTENCY_WINDOW_SECONDS=10

# 系统模型（由管理员在服务器环境配置）
DOUBAO_API_KEY=your-doubao-api-key
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_CHAT_ENDPOINT=doubao-seed-1-6-250615
DOUBAO_VISION_ENDPOINT=doubao-seed-1-6-250615
DOUBAO_AVAILABLE_MODELS=doubao-seed-1-6-250615

# 部署平台兼容变量；代码主入口仍为 YUNXUN_PORT 和 YUNXUN_DATABASE_URL。
# PORT=8001
# YUNXUN_DB_PATH=./backend/yunxun.db
